{
  "name": "@umari/js",
  "version": "0.1.0",
  "description": "TypeScript SDK for authoring Umari WASM modules (commands, projectors, effects).",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "umari-js": "./bin/umari-js.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    }
  },
  "files": [
    "dist",
    "wit",
    "bin",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "prepare": "node scripts/copy-wit.mjs",
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@bytecodealliance/jco": "^1.24.1",
    "esbuild": "^0.28.1"
  },
  "peerDependenciesMeta": {
    "@bytecodealliance/jco": { "optional": false },
    "esbuild": { "optional": false }
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.24.1",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.0"
  }
}
