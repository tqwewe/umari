{
  "name": "@umari/js",
  "version": "0.1.0",
  "description": "TypeScript SDK for authoring Umari WASM modules (commands, projectors, effects).",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "bin": {
    "umari-js": "./bin/umari-js.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    }
  },
  "files": [
    "dist",
    "wit",
    "bin",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "prepare": "node scripts/copy-wit.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@bytecodealliance/jco": "^1.17.0",
    "esbuild": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "@bytecodealliance/jco": { "optional": false },
    "esbuild": { "optional": false }
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.17.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
